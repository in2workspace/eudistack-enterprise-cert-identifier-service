{
  "name": "eudistack-enterprise-cert-identifier-service",
  "version": "0.1.2",
  "private": true,
  "description": "Backend de Identificación con certificado FNMT (CGCOM) — cert-server mTLS + proxy de bootstrap al issuer. Material de demo extraído de demo-cgcom.",
  "type": "module",
  "scripts": {
    "start": "node server/cert-server.mjs",
    "cert-server": "node server/cert-server.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-include=server/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"test/**/*.test.mjs\"",
    "sbom": "cyclonedx-npm --spec-version 1.6 --output-format JSON --output-file build/sbom/sbom.json --package-lock-only --output-reproducible"
  },
  "dependencies": {
    "node-forge": "^1.3.3"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1"
  }
}
